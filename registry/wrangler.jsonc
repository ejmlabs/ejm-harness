{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ejm-registry",
    "account_id": "478a0db3a110d8503c16abbc1db27af4",
    "main": "build/worker/shim.mjs",
    "compatibility_date": "2026-10-18",
    "workers_dev": false,
    "preview_urls": false,
    "build": { "command": "npm run build:web && worker-build --release -- --locked" },
    "vars": { "REGISTRY_ORIGIN": "https://registry.ejmlabs.com" },
    "services": [{ "binding": "AUTH", "service": "ejm-registry-auth" }],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ejm-registry",
            "database_id": "00000000-0000-0000-0000-000000000001",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "ejm-registry-packages" }],
    "ratelimits": [
        { "name": "EDGE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    ],
    "assets": { "directory": ".web-assets", "binding": "ASSETS", "run_worker_first": true },
    "routes": [{ "pattern": "registry.ejmlabs.com", "custom_domain": true }],
    "observability": { "enabled": false },
}
