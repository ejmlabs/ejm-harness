{
  "name": "ejm-harness",
  "version": "0.1.1",
  "description": "TypeScript SDK for ejm-harness's Rust worker",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejmlabs/ejm-harness.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/ejmlabs/ejm-harness/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/ejmlabs/ejm-harness/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2"
  }
}
