#!/bin/sh
set -eu

project_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
mkdir -p "$project_root/target"
service_dir=$(mktemp -d "$project_root/target/secret-service.XXXXXXXX")
trap 'rm -rf "$service_dir"' EXIT
trap 'exit 1' HUP INT TERM
mkdir "$service_dir/data" "$service_dir/runtime"
chmod 700 "$service_dir/runtime"
printf '%s' 'ejm-harness-test-only' > "$service_dir/password"
dbus-run-session -- sh -c '
    set -eu
    service_dir=$1
    shift
    export XDG_DATA_HOME="$service_dir/data"
    export XDG_RUNTIME_DIR="$service_dir/runtime"
    unset GNOME_KEYRING_CONTROL
    gnome-keyring-daemon --foreground --unlock --components=secrets \
        --control-directory "$service_dir/runtime" < "$service_dir/password" &
    service_pid=$!
    trap '\''kill "$service_pid" 2>/dev/null || :; wait "$service_pid" 2>/dev/null || :'\'' EXIT
    trap '\''exit 1'\'' HUP INT TERM
    gdbus wait --session --timeout 10 org.freedesktop.secrets
    "$@"
' sh "$service_dir" "$@"
