{
  "name": "@ejm/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ejmlabs components, hooks, layouts, views, styles and art on React and Tailwind v4.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./styles-docs.css": "./src/styles-docs.css",
    "./styles-app.css": "./src/styles-app.css",
    "./styles-terminal.css": "./src/styles-terminal.css",
    "./theme-boot.js": "./public/theme-boot.js",
    "./font-preloads": "./src/font-preloads.ts",
    "./catalog.json": "./src/catalog.json",
    "./fonts/*": "./src/fonts/*",
    "./art/*": "./src/art/*",
    "./app": "./src/app/index.ts",
    "./app/messages": "./src/app/messages.ts",
    "./app/scale": "./src/app/scale.ts",
    "./app/useBox": "./src/app/useBox.ts",
    "./app/*": "./src/app/*.tsx",
    "./docs": "./src/docs/index.ts",
    "./docs/highlight": "./src/docs/highlight.ts",
    "./docs/highlight-all": "./src/docs/highlight-all.ts",
    "./docs/hooks": "./src/docs/hooks.ts",
    "./docs/*": "./src/docs/*.tsx",
    "./motion": "./src/motion/index.ts",
    "./motion/useDrawOn": "./src/motion/useDrawOn.ts",
    "./motion/useReveal": "./src/motion/useReveal.ts",
    "./motion/*": "./src/motion/*.tsx",
    "./layout": "./src/layout/index.ts",
    "./layout/*": "./src/layout/*.tsx",
    "./shell": "./src/shell/index.ts",
    "./shell/*": "./src/shell/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/TerminalWorkspace": "./src/terminal/TerminalWorkspace.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./styles-static.css": "./src/styles-static.css",
    "./components/NativeCheckbox": "./src/static/NativeCheckbox.tsx",
    "./shell/Disclosure": "./src/static/Disclosure.tsx",
    "./layout/ActionRows": "./src/static/ActionRows.tsx",
    "./layout/DocumentContent": "./src/static/DocumentContent.tsx"
  },
  "scripts": {
    "check": "node scripts/check-art.mjs && node scripts/check-containerless.mjs && node scripts/check-components.mjs && node scripts/check-treeshake.mjs && node scripts/check-sources.mjs && node scripts/build-merge-config.mjs --check && node scripts/build-catalog.mjs --check"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/components/test-setup.tsx",
    "!src/**/README.md",
    "public/theme-boot.js",
    "THEME.md",
    "COMPONENTS.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@ejm/core": "0.1.0",
    "@ejm/tokens": "0.1.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "vitest-axe": "^0.1.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejmlabs/ejm-ui.git",
    "directory": "packages/ui"
  }
}
