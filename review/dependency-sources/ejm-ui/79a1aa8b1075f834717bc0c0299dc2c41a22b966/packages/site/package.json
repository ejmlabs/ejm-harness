{
  "name": "@ejm/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared behavior of every ejmlabs site: the project registry, Cloudflare Web Analytics, the shared head, theme boot and security headers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ejm-site-headers": "./bin/ejm-site-headers.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics.tsx",
    "./head": "./src/head.ts",
    "./headers": "./src/headers.mjs",
    "./projects": "./src/projects.mjs",
    "./vite": "./src/vite.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@ejm/ssg": "0.1.0",
    "react": "^19.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@ejm/tokens": "0.1.0",
    "@ejm/ui": "0.1.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejmlabs/ejm-ui.git",
    "directory": "packages/site"
  }
}
