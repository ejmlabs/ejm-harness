{
  "name": "@ejm/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ejmlabs brand tokens: theme.json, brand assets and the generators for Tailwind, CSS, Rust, Monaco and terminal themes.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind.css": "./generated/tailwind.css",
    "./window.css": "./generated/window.css",
    "./neutral.css": "./generated/neutral.css",
    "./theme.css": "./generated/theme.css",
    "./theme.json": "./theme.json",
    "./generated/*": "./generated/*",
    "./assets/*": "./assets/*",
    "./rust/*": "./rust/*"
  },
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "check": "node scripts/build-ui.mjs --check",
    "pack:check": "node scripts/check-brand-pack.mjs"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "generated",
    "rust",
    "theme.json",
    "README.md",
    "assets",
    "!assets/**/*.zip",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejmlabs/ejm-ui.git",
    "directory": "packages/tokens"
  }
}
