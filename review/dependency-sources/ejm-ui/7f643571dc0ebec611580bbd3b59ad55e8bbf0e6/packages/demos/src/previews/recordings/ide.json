     "text": "use std::time::{Duration, Instant};\n\n/// Wait before the next attempt, doubling each time.\npub fn retry_backoff(attempt: u32) -> Duration {\n    Duration::from_millis(100 << attempt.min(6))\n}\n\n/// True while the retry window is still open.\npub fn window_open(started: Instant, budget: Duration) -> bool {\n    window_open_at(started, Instant::now(), budget)\n}\n\nfn window_open_at(started: Instant, now: Instant, budget: Duration) -> bool {\n    now.duration_since(started) < budget\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn window_is_open_at_start() {\n        let started = Instant::now();\n        assert!(window_open_at(started, started, Duration::from_millis(5)));\n    }\n\n    #[test]\n    fn window_is_open_before_deadline() {\n        let started = Instant::now();\n        let now = started + Duration::from_millis(4);\n        assert!(window_open_at(started, now, Duration::from_millis(5)));\n    }\n\n    #[test]\n    fn window_is_closed_at_deadline() {\n        let started = Instant::now();\n        let now = started + Duration::from_millis(5);\n        assert!(!window_open_at(started, now, Duration::from_millis(5)));\n    }\n\n    #[test]\n    fn window_is_closed_after_deadline() {\n        let started = Instant::now();\n        let now = started + Duration::from_millis(6);\n        assert!(!window_open_at(started, now, Duration::from_millis(5)));\n    }\n\n    #[test]\n    fn zero_budget_is_closed() {\n        let started = Instant::now();\n        assert!(!window_open_at(started, started, Duration::ZERO));\n    }\n}\n"
    },
