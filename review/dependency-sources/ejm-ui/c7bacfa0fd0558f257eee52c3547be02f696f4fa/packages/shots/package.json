{
  "name": "@ejm/shots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real product shots: runs the real ejm-cli and ejm-harness in a pseudo-terminal and renders the screen as a PNG with the product's own colors and IBM Plex Mono.",
  "bin": {
    "ejm-capture-terminal": "./src/capture.mjs"
  },
  "scripts": {
    "capture": "node ../../scripts/capture-terminal.mjs",
    "optimize": "node scripts/optimize.mjs"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.5"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./ide": "./src/ide.ts",
    "./harness": "./src/harness.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejmlabs/ejm-ui.git",
    "directory": "packages/shots"
  }
}
